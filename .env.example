# --- Required ---------------------------------------------------------------
DATABASE_URL="postgresql://ganapathy:ganapathy@localhost:5432/ganapathy?schema=public"
# Admin sign-in. Use a real inbox: "Forgot password" e-mails the reset link here
# (needs the SMTP settings below). After a reset, the new password replaces ADMIN_PASSWORD.
ADMIN_EMAIL="owner@example.se"
ADMIN_PASSWORD="change-me-now"
# Generate with:  openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-secret"

# --- Store details (shown in header, footer, checkout) -----------------------
# COMPANY_NAME is the legal company shown only in the footer.
NEXT_PUBLIC_STORE_NAME="TamilKadai"
STORE_PHONE="073-577 35 60"
STORE_EMAIL="tamilkadaise@gmail.com"
STORE_ADDRESS="Gasverksgatan 13, 252 18 Helsingborg"
STORE_HOURS="Open every day 09:00–20:30"
STORE_MAP_URL="https://maps.app.goo.gl/aZpgWBusAx839gkP7"
WHATSAPP_GROUP_URL="https://chat.whatsapp.com/GFdOTb2ZFVh4S2pxpiQXBr"
COMPANY_NAME="Ganapathy Supermarket AB"
COMPANY_ORG_NUMBER="559131-5956"
# Leave empty to hide the "Swish now" option at checkout
SWISH_NUMBER=""

# --- Delivery rules (amounts in öre: 4900 = 49 kr) ---------------------------
DELIVERY_FEE_ORE=4900
FREE_DELIVERY_MIN_ORE=49900
MIN_DELIVERY_ORDER_ORE=19900
LOW_STOCK_THRESHOLD=10
# Home delivery only inside this area (postal code prefixes). Others must pick up in store.
DELIVERY_AREA="Helsingborg"
DELIVERY_POSTCODE_PREFIXES="250,251,252,253,254,255,256"

# --- Automatic order e-mails (Gmail, free) -----------------------------------
# 1. Turn on 2-Step Verification on the Gmail account
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Paste the Gmail address and the 16-letter app password below
SMTP_USER="tamilkadaise@gmail.com"
SMTP_PASS=""
# Where new-order alerts go (defaults to SMTP_USER)
STORE_ORDER_EMAIL=""
# Public address of the shop, used for links and the logo in e-mails
SITE_URL="http://localhost:3000"

# Set to 1 only if you run production over plain http (no HTTPS) for testing
INSECURE_COOKIES=0

# --- Production server only ------------------------------------------------
# Database password used by docker compose (generate: openssl rand -hex 24)
POSTGRES_PASSWORD="replace-with-a-long-random-password"
# Domain(s) Caddy serves with HTTPS, comma separated
SITE_DOMAINS="tamilkadai.se, www.tamilkadai.se"

# Set to off on the real shop so no demo products or demo coupon are created
SEED_DEMO=off
