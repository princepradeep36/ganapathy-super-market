generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String    @default("🛒")
  sortOrder Int       @default(0)
  // Set for a sub-category (e.g. Rice → 5 kg). Only one level deep.
  parentId  String?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")
  products  Product[]
}

/** Seasonal shelves such as "Diwali 2026": one product can be in several. */
model Collection {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String    @default("✨")
  description String    @default("")
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

/** "Can you stock this?" requests from customers. */
model ProductRequest {
  id          String   @id @default(cuid())
  productName String
  details     String?
  name        String
  phone       String?
  email       String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  unit        String?
  price       Int
  salePrice   Int?
  saleStart   DateTime?
  saleEnd     DateTime?
  stock       Int         @default(0)
  image       String
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  collections Collection[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([active, categoryId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  type           String    @default("PERCENT")
  value          Int
  minOrder       Int       @default(0)
  maxDiscount    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  stackWithSales Boolean   @default(true)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id                    String      @id @default(cuid())
  // 8-digit number customers quote to the store (older orders get one on start-up).
  number                Int?        @unique
  customerName          String
  email                 String
  phone                 String
  address               String
  postalCode            String
  city                  String
  deliveryMethod        String      @default("PICKUP")
  deliverySlot          String?
  notes                 String?
  paymentMethod         String      @default("PAY_AT_PICKUP")
  paid                  Boolean     @default(false)
  status                String      @default("NEW")
  originalSubtotal      Int         @default(0)
  itemDiscountTotal     Int         @default(0)
  subtotalAfterItemDisc Int         @default(0)
  couponCode            String?
  orderDiscountTotal    Int         @default(0)
  deliveryFee           Int         @default(0)
  total                 Int
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt
  items                 OrderItem[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  name             String
  regularUnitPrice Int     @default(0)
  unitPrice        Int
  itemDiscount     Int     @default(0)
  quantity         Int
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])
}

/** Extra home page banner slides, shown after the main banner in sortOrder. */
model Banner {
  id        String    @id @default(cuid())
  image     String
  title     String
  link      String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  // FILL: covers the whole slide (edges may be cropped); WHOLE: shows the entire image.
  fit       String    @default("FILL")
  // Which part stays visible when filling: top, center or bottom.
  focus     String    @default("center")
  // Also shown as a pop-up once per visit when someone opens the shop.
  popup     Boolean   @default(false)
  createdAt DateTime  @default(now())
}

/** The single store admin. A password set via "Forgot password" replaces ADMIN_PASSWORD. */
model AdminAccount {
  id              String    @id @default("admin")
  passwordHash    String?
  // Bumped on every password change so older sign-ins stop working.
  passwordVersion Int       @default(0)
  resetTokenHash  String?
  resetExpires    DateTime?
  updatedAt       DateTime  @updatedAt
}

/** Delivery / pickup times offered at checkout, set by the admin. */
model DeliverySchedule {
  id            String   @id @default("main")
  // Weekdays with slots: 0 = Sunday … 6 = Saturday.
  days          Int[]
  slots         String[]
  cutoffMinutes Int      @default(120)
  daysAhead     Int      @default(3)
  // "YYYY-MM-DD" dates with no slots (holidays).
  closedDates   String[]
  allowAsap     Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
